{
  "appId": "com.jplundberg.cmd",
  "appName": "cmd",
  "webDir": "www",
  "server": {
    "url": "https://jplundberg.com/cmd/",
    "allowNavigation": [
      "jplundberg.com",
      "cmd-lundberg.cloudflareaccess.com"
    ],
    "errorPath": "error.html"
  },
  "ios": {
    "appendUserAgent": "cmdapp/1",
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true,
    "webContentsDebuggingEnabled": true
  },
  "backgroundColor": "#0e0f10",
  "plugins": {
    "Keyboard": {
      "resize": "native"
    }
  }
}