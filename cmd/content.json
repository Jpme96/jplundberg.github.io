{% comment %} Titles and links of published articles and projects, for the website settings in the dashboard. {% endcomment %}
{"articles": [{% for a in site.articles %}{"ref": {{ a.ref | default: a.slug | jsonify }}, "lang": {{ a.lang | default: 'en' | jsonify }}, "title": {{ a.title | jsonify }}, "url": {{ a.url | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
 "projects": [{% for p in site.projects %}{"ref": {{ p.ref | default: p.slug | jsonify }}, "lang": {{ p.lang | default: 'en' | jsonify }}, "title": {{ p.title | jsonify }}, "url": {{ p.url | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
