{
  "name": "JPL Dashboard",
  "short_name": "Dashboard",
  "description": "John Paul Lundberg's private dashboard",
  "id": "/cmd/",
  "start_url": "/cmd/",
  "scope": "/cmd/",
  "display": "standalone",
  "background_color": "#0e0f11",
  "theme_color": "#0e0f11",
  "icons": [
    {
      "src": "/cmd/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/cmd/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/cmd/assets/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Plan my day",
      "url": "/cmd/#plan"
    },
    {
      "name": "New task",
      "url": "/cmd/?add=task"
    },
    {
      "name": "Calendar",
      "url": "/cmd/calendar/"
    },
    {
      "name": "Finances",
      "url": "/cmd/finance/"
    }
  ],
  "share_target": {
    "action": "/cmd/",
    "method": "GET",
    "params": {
      "title": "stitle",
      "text": "stext",
      "url": "surl"
    }
  }
}
